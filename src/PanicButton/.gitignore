.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# The repo-root (Python) .gitignore excludes any lib/ directory; re-include
# PlatformIO's project-local library folder so private libs get committed.
!lib/

# Generated by `pio run -t compiledb` for clangd; machine-specific paths.
compile_commands.json

# Wi-Fi credentials. Copy include/secrets.example.h -> include/secrets.h and
# fill it in; the real file must never be committed (public repo).
include/secrets.h

# Machine-specific PlatformIO overrides (COM port etc.), merged via extra_configs.
platformio.local.ini
